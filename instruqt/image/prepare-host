#!/usr/bin/env bash
set -euo pipefail

if [[ "$EUID" -ne 0 ]]; then
  echo "Run this script as root only while building the disposable Instruqt Host image." >&2
  exit 1
fi

. /etc/os-release
if [[ "$ID" != ubuntu || ( "$VERSION_CODENAME" != jammy && "$VERSION_CODENAME" != noble ) ]]; then
  echo "Expected Ubuntu 22.04 or 24.04; found ${ID:-unknown} ${VERSION_CODENAME:-unknown}." >&2
  exit 1
fi

apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ca-certificates curl gnupg jq tar

if ! command -v atlas >/dev/null 2>&1 || ! command -v mongosh >/dev/null 2>&1; then
  mkdir -p /usr/share/keyrings /etc/apt/sources.list.d
  curl -fsSL https://pgp.mongodb.com/server-8.0.asc | \
    gpg --dearmor --yes -o /usr/share/keyrings/mongodb-server-8.0.gpg
  printf 'deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] https://repo.mongodb.com/apt/ubuntu %s/mongodb-enterprise/8.0 multiverse\n' "$VERSION_CODENAME" \
    > /etc/apt/sources.list.d/mongodb-enterprise-8.0.list
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq mongodb-atlas-cli mongodb-mongosh
fi

atlas --version
mongosh --version
jq --version
curl --version | head -n 1
tar --version | head -n 1
printf 'Atlas workstation tools installed. Do not authenticate to Atlas in the image builder.\n'