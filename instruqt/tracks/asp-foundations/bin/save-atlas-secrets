#!/usr/bin/env bash
set -euo pipefail

read -r -s -p "Atlas cluster URI: " ATLAS_URI
printf '\n'
read -r -s -p "ASP workspace URI: " ASP_URI
printf '\n'

if [[ -z "$ATLAS_URI" || -z "$ASP_URI" ]]; then
  echo "Both connection URIs are required to configure this sandbox." >&2
  exit 1
fi

temporary_file="$(mktemp)"
trap 'rm -f "$temporary_file"' EXIT
umask 077
printf 'export ATLAS_URI=%q\nexport ASP_URI=%q\n' \
  "$ATLAS_URI" "$ASP_URI" > "$temporary_file"
chmod 0600 "$temporary_file"
mv "$temporary_file" /tmp/asp-playground-secrets
trap - EXIT

unset ATLAS_URI ASP_URI