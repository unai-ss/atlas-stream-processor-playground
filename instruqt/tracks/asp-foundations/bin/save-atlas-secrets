#!/usr/bin/env bash
set -euo pipefail

read -r -s -p "Atlas cluster URI: " ATLAS_URI
printf '\n'
read -r -s -p "ASP workspace URI: " ASP_URI
printf '\n'
read -r -p "Atlas egress CIDRs for this workspace (comma-separated): " ATLAS_KAFKA_ALLOWED_CIDRS

if [[ -z "$ATLAS_URI" || -z "$ASP_URI" || -z "$ATLAS_KAFKA_ALLOWED_CIDRS" ]]; then
  echo "All three values are required to configure this sandbox." >&2
  exit 1
fi

temporary_file="$(mktemp)"
trap 'rm -f "$temporary_file"' EXIT
umask 077
printf 'export ATLAS_URI=%q\nexport ASP_URI=%q\nexport ATLAS_KAFKA_ALLOWED_CIDRS=%q\n' \
  "$ATLAS_URI" "$ASP_URI" "$ATLAS_KAFKA_ALLOWED_CIDRS" > "$temporary_file"
chmod 0600 "$temporary_file"
mv "$temporary_file" /tmp/asp-playground-secrets
trap - EXIT

unset ATLAS_URI ASP_URI ATLAS_KAFKA_ALLOWED_CIDRS
bootstrap_script="$(dirname "$0")/bootstrap-kafka"
if [[ "$EUID" -eq 0 ]]; then
  "$bootstrap_script"
elif command -v sudo >/dev/null 2>&1; then
  sudo "$bootstrap_script"
else
  echo "Kafka setup needs root privileges; rerun this helper with sudo available." >&2
  exit 1
fi