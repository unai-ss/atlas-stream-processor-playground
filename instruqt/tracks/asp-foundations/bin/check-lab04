#!/usr/bin/env bash
set -euo pipefail
source /opt/asp-playground/instruqt/tracks/asp-foundations/bin/load-secrets
: "${INSTRUQT_PARTICIPANT_ID:?This check must run inside Instruqt}"
if [[ ! "$INSTRUQT_PARTICIPANT_ID" =~ ^[A-Za-z0-9-]+$ ]]; then
  echo "Unexpected characters in the Instruqt participant ID." >&2
  exit 2
fi
sensor_id="sensor-${INSTRUQT_PARTICIPANT_ID:0:8}"

connection_output="$(docker run --rm --network host -e ASP_URI="$ASP_URI" mongo:8.0 \
  mongosh "$ASP_URI" --quiet --eval 'printjson(sp.listConnections())')"
if ! grep -q 'kafka_lab' <<<"$connection_output"; then
  echo "FAIL: kafka_lab is not in this participant's ASP Connection Registry." >&2
  exit 1
fi

eval_code="const sensorId = '${sensor_id}';"
eval_code+=$'\nconst database = db.getSiblingDB("playground");'
eval_code+=$'\nconst repaired = database.sensor_weather.findOne({ _id: sensorId });'
eval_code+=$'\nconst lateCount = database.sensor_dlq.countDocuments({ "fullDocument.errInfo.reason": "Input document arrived late." });'
eval_code+=$'\nif (repaired && repaired.temperature === 23.7 && lateCount > 0) print("PASS"); else print("WAIT");'

for attempt in $(seq 1 10); do
  result="$(docker run --rm --network host -e ATLAS_URI="$ATLAS_URI" mongo:8.0 \
    mongosh "$ATLAS_URI" --quiet --eval "$eval_code")"
  if [[ "$result" == "PASS" ]]; then
    echo "PASS: late input was captured and repaired into sensor_weather."
    exit 0
  fi
  sleep 4
done

echo "FAIL: late input was not repaired within 40 seconds. Check processor state and DLQ." >&2
exit 1
