#!/usr/bin/env bash
set -euo pipefail

source /opt/asp-playground/instruqt/tracks/asp-foundations/bin/load-secrets
: "${INSTRUQT_PARTICIPANT_ID:?This command must run inside Instruqt}"

event_count="${1:-100}"
if [[ ! "$event_count" =~ ^[0-9]+$ ]] || (( event_count < 4 || event_count > 5000 )); then
  echo "Usage: seed-parallelism [event-count: 4..5000]" >&2
  exit 2
fi
run_id="asp-${INSTRUQT_PARTICIPANT_ID}-$(date -u +%Y%m%d%H%M%S)"
if [[ ! "$INSTRUQT_PARTICIPANT_ID" =~ ^[A-Za-z0-9-]+$ ]]; then
  echo "Unexpected characters in the Instruqt participant ID." >&2
  exit 2
fi
eval_code="SEED_RUN_ID='${run_id}'; SEED_EVENT_COUNT=${event_count}; load('/opt/asp-playground/scripts/08-seed-parallelism.js')"
printf '%s\n' "$run_id" > /tmp/asp-playground-run-id
mongosh "$ATLAS_URI" --quiet --eval "$eval_code"
printf 'Seeded run_id=%s with event_count=%s.\n' "$run_id" "$event_count"
