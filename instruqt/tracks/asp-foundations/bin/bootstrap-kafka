#!/usr/bin/env bash
set -euo pipefail

KAFKA_DIR="/opt/asp-kafka"
DATA_DIR="$KAFKA_DIR/data"
CERT_DIR="/etc/asp-kafka/tls"
SERVER_PROPERTIES="$KAFKA_DIR/server.properties"
IMAGE="apache/kafka:4.0.0"
BROKER_HOST="kafka.${_SANDBOX_ID}.instruqt.io"
BROKER_PORT="9094"
PASSWORD_FILE="$KAFKA_DIR/kafka-password"
: "${ATLAS_KAFKA_ALLOWED_CIDRS:?Configure Atlas egress CIDRs before exposing Kafka}"

mkdir -p "$KAFKA_DIR" "$DATA_DIR" "$CERT_DIR"
chmod 0700 "$KAFKA_DIR"

if [[ ! -s "$PASSWORD_FILE" ]]; then
  openssl rand -hex 24 > "$PASSWORD_FILE"
fi
chmod 0600 "$PASSWORD_FILE"
KAFKA_PASSWORD="$(<"$PASSWORD_FILE")"

iptables -N ASP_KAFKA 2>/dev/null || iptables -F ASP_KAFKA
iptables -A ASP_KAFKA -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A ASP_KAFKA -s 127.0.0.1 -j ACCEPT
IFS=',' read -r -a atlas_cidrs <<< "$ATLAS_KAFKA_ALLOWED_CIDRS"
for cidr in "${atlas_cidrs[@]}"; do
  if [[ ! "$cidr" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$ ]]; then
    echo "Invalid Atlas egress CIDR: $cidr" >&2
    exit 1
  fi
  iptables -A ASP_KAFKA -s "$cidr" -j ACCEPT
done
iptables -A ASP_KAFKA -j DROP
iptables -C INPUT -p tcp --dport "$BROKER_PORT" -j ASP_KAFKA 2>/dev/null || \
  iptables -I INPUT 1 -p tcp --dport "$BROKER_PORT" -j ASP_KAFKA

metadata_url="http://metadata.google.internal/computeMetadata/v1/instance/attributes"
for attempt in $(seq 1 30); do
  if curl --fail --silent --show-error --header 'Metadata-Flavor: Google' \
    "$metadata_url/ssl-certificate" -o "$CERT_DIR/server.crt" &&
    curl --fail --silent --show-error --header 'Metadata-Flavor: Google' \
      "$metadata_url/ssl-certificate-key" -o "$CERT_DIR/server.key"; then
    break
  fi
  if [[ "$attempt" -eq 30 ]]; then
    echo "Could not retrieve the Instruqt-provisioned TLS certificate." >&2
    exit 1
  fi
  sleep 2
done

chmod 0644 "$CERT_DIR/server.crt"
chmod 0400 "$CERT_DIR/server.key"

cat > "$SERVER_PROPERTIES" <<EOF
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@kafka:9093
listeners=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,SASL_SSL://0.0.0.0:${BROKER_PORT}
advertised.listeners=PLAINTEXT://kafka:9092,SASL_SSL://${BROKER_HOST}:${BROKER_PORT}
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SASL_SSL:SASL_SSL
inter.broker.listener.name=PLAINTEXT
controller.listener.names=CONTROLLER
log.dirs=/var/lib/kafka/data
num.partitions=3
auto.create.topics.enable=false
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
ssl.keystore.type=PEM
ssl.keystore.certificate.chain=/etc/kafka/tls/server.crt
ssl.keystore.key=/etc/kafka/tls/server.key
sasl.enabled.mechanisms=PLAIN
listener.name.sasl_ssl.plain.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username="asp" password="${KAFKA_PASSWORD}" user_asp="${KAFKA_PASSWORD}";
EOF
chmod 0400 "$SERVER_PROPERTIES"

cat > "$CERT_DIR/client.properties" <<EOF
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username="asp" password="${KAFKA_PASSWORD}";
ssl.endpoint.identification.algorithm=
EOF
chmod 0400 "$CERT_DIR/client.properties"

KAFKA_UID="$(docker run --rm --entrypoint id "$IMAGE" -u)"
chown -R "$KAFKA_UID:$KAFKA_UID" "$DATA_DIR" "$CERT_DIR" "$SERVER_PROPERTIES"
chmod 0750 "$DATA_DIR" "$CERT_DIR"
chmod 0444 "$CERT_DIR/server.crt"
chmod 0400 "$CERT_DIR/server.key" "$CERT_DIR/client.properties" "$SERVER_PROPERTIES"

if [[ ! -f "$KAFKA_DIR/cluster-id" ]]; then
  docker run --rm --entrypoint /opt/kafka/bin/kafka-storage.sh \
    "$IMAGE" random-uuid > "$KAFKA_DIR/cluster-id"
fi
cluster_id="$(cat "$KAFKA_DIR/cluster-id")"
docker run --rm \
  --entrypoint /opt/kafka/bin/kafka-storage.sh \
  -v "$DATA_DIR:/var/lib/kafka/data" \
  -v "$SERVER_PROPERTIES:/etc/kafka/server.properties:ro" \
  -v "$CERT_DIR:/etc/kafka/tls:ro" \
  "$IMAGE" format --ignore-formatted \
  --cluster-id "$cluster_id" --config /etc/kafka/server.properties

docker rm --force asp-kafka >/dev/null 2>&1 || true
docker run --detach \
  --name asp-kafka \
  --hostname kafka \
  --entrypoint /opt/kafka/bin/kafka-server-start.sh \
  --restart unless-stopped \
  --publish "${BROKER_PORT}:${BROKER_PORT}" \
  --volume "$DATA_DIR:/var/lib/kafka/data" \
  --volume "$SERVER_PROPERTIES:/etc/kafka/server.properties:ro" \
  --volume "$CERT_DIR:/etc/kafka/tls:ro" \
  "$IMAGE" /etc/kafka/server.properties

for attempt in $(seq 1 60); do
  if docker exec asp-kafka /opt/kafka/bin/kafka-topics.sh \
    --bootstrap-server localhost:"$BROKER_PORT" \
    --command-config /etc/kafka/tls/client.properties --list >/dev/null 2>&1; then
    break
  fi
  if [[ "$attempt" -eq 60 ]]; then
    docker logs asp-kafka >&2 || true
    echo "Kafka did not become ready." >&2
    exit 1
  fi
  sleep 2
done

for topic in temperature humidity; do
  docker exec asp-kafka /opt/kafka/bin/kafka-topics.sh \
    --bootstrap-server localhost:"$BROKER_PORT" \
    --command-config /etc/kafka/tls/client.properties \
    --create --if-not-exists --topic "$topic" --partitions 3 --replication-factor 1
done

printf 'Kafka endpoint: %s:%s\n' "$BROKER_HOST" "$BROKER_PORT"
printf 'Kafka topics: temperature, humidity\n'
printf 'Kafka SASL username: asp (password is stored in a protected per-sandbox file)\n'
