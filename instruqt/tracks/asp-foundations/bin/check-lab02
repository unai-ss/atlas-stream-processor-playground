#!/usr/bin/env bash
set -euo pipefail
source /opt/asp-playground/instruqt/tracks/asp-foundations/bin/load-secrets
for attempt in $(seq 1 10); do
  output="$(mongosh "$ATLAS_URI" --quiet --eval \
    'const latest = db.getSiblingDB("playground").taco_locations.findOne({ _id: "taco-001" }); print(latest && latest.dist === 400 && latest.status === "delivered" ? "PASS" : "WAIT")')"
  if [[ "$output" == "PASS" ]]; then
    echo "PASS: materialized view contains the latest delivery state."
    exit 0
  fi
  sleep 5
done
echo "FAIL: expected taco-001 at dist 400 with delivered status after the window closes." >&2
exit 1
