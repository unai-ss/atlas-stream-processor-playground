#!/usr/bin/env bash
set -euo pipefail

docker inspect --format '{{.State.Running}}' asp-kafka | grep -qx true
for topic in temperature humidity; do
  docker exec asp-kafka /opt/kafka/bin/kafka-topics.sh \
    --bootstrap-server localhost:9094 \
    --command-config /etc/kafka/tls/client.properties \
    --describe --topic "$topic" >/dev/null
done
/opt/asp-playground/instruqt/tracks/asp-foundations/bin/show-kafka-endpoint
echo "Kafka broker and required topics are ready."
