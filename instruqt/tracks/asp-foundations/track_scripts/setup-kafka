#!/usr/bin/env bash
set -euo pipefail

until [[ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]]; do
  sleep 1
done

if ! command -v git >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1 || ! command -v iptables >/dev/null 2>&1 || ! command -v gpg >/dev/null 2>&1; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git jq curl ca-certificates openssl iptables gnupg sudo
fi

if ! command -v atlas >/dev/null 2>&1; then
  . /etc/os-release
  if [[ "$ID" != "ubuntu" || ( "$VERSION_CODENAME" != "jammy" && "$VERSION_CODENAME" != "noble" ) ]]; then
    echo "Atlas CLI setup supports Ubuntu 22.04 and 24.04 on this track." >&2
    exit 1
  fi
  curl -fsSL https://pgp.mongodb.com/server-8.0.asc | \
    gpg --dearmor --yes -o /usr/share/keyrings/mongodb-server-8.0.gpg
  echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] https://repo.mongodb.com/apt/ubuntu ${VERSION_CODENAME}/mongodb-enterprise/8.0 multiverse" \
    > /etc/apt/sources.list.d/mongodb-enterprise-8.0.list
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq mongodb-atlas-cli
fi

for attempt in $(seq 1 30); do
  if docker info >/dev/null 2>&1; then
    break
  fi
  if [[ "$attempt" -eq 30 ]]; then
    echo "Docker Engine did not become ready on the Instruqt VM." >&2
    exit 1
  fi
  sleep 2
done

if [[ ! -d /opt/asp-playground/.git ]]; then
  git clone --depth 1 --branch "${ASP_PLAYGROUND_REF:-main}" \
    https://github.com/[redacted]/atlas-stream-processor-playground.git /opt/asp-playground
fi
  docker pull apache/kafka:4.0.0
  docker pull mongo:8.0
