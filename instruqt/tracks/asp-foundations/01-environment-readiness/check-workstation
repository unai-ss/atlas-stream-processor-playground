#!/usr/bin/env bash
set -euo pipefail
if [[ -f /tmp/instruqt-test-solved-environment ]]; then
  echo "PASS: simulated solve path used by Instruqt track test."
  exit 0
fi
source /opt/asp-playground/instruqt/tracks/asp-foundations/bin/load-secrets
/opt/asp-playground/instruqt/tracks/asp-foundations/bin/check-atlas-access
connections="$(mongosh "$ASP_URI" --quiet --eval 'printjson(sp.listConnections())')"
for required in sample_stream_solar atlas_lab; do
  if ! grep -q "$required" <<<"$connections"; then
    echo "FAIL: required ASP connection is missing: $required" >&2
    exit 1
  fi
done
echo "PASS: test Atlas cluster and required ASP connections are available."